APP_NAME="Haridy ERP"
APP_ENV=production
APP_PORT=8080
APP_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=haridy_inventory
DB_SSLMODE=disable

SESSION_NAME=haridy_session
SESSION_MAX_AGE=28800

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
