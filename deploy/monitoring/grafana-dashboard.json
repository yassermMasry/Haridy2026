{
  "title": "Haridy Production",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests",
      "targets": [{"expr": "haridy_http_requests_total"}],
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4}
    },
    {
      "type": "stat",
      "title": "HTTP Errors",
      "targets": [{"expr": "haridy_http_errors_total"}],
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4}
    },
    {
      "type": "stat",
      "title": "Average Latency",
      "targets": [{"expr": "haridy_http_latency_average_microseconds"}],
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4}
    }
  ]
}
