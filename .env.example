APP_NAME="Haridy Inventory"
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-this-secret-in-production
APP_SECRETS=change-this-secret-in-production,previous-secret-during-rotation
JWT_SECRET=change-this-jwt-secret-in-production
JWT_SECRETS=change-this-jwt-secret-in-production,previous-jwt-secret-during-rotation

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=haridy_inventory
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

SESSION_NAME=haridy_session
SESSION_MAX_AGE=28800

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_S3_URI=
BACKUP_AGE_PUBLIC_KEY=
BACKUP_AGE_IDENTITY=
DEMO_MODE=true
LICENSE_KEY=DEMO-LICENSE
